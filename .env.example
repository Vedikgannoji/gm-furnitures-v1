# Server Configuration
PORT=3001
NODE_ENV=development
APP_URL=http://localhost:5173

# Authentication Secrets
JWT_SECRET=your_jwt_secret_change_in_production
JWT_EXPIRES_IN=7d

# Google OAuth Credentials (for Sign in with Google)
# Obtain from Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
VITE_GOOGLE_CLIENT_ID=

# Database Configuration (Path to SQLite file)
DATABASE_PATH=server/data/gm_furniture.db
