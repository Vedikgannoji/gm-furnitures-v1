# ============================================================
# GM FURNITURE — ENVIRONMENT CONFIGURATION
# Architecture: Vercel (Frontend & Serverless API) + Neon PostgreSQL
# Target URL:   https://gmfurniture.vercel.app
# ============================================================

# Server Configuration
PORT=3001
NODE_ENV=development
# APP_URL:
# For local development: http://localhost:5173
# For Vercel production: https://gmfurniture.vercel.app
APP_URL=http://localhost:5173

# Authentication Secrets (Generate a secure 32+ character key for production)
JWT_SECRET=your_jwt_secret_change_in_production
JWT_EXPIRES_IN=7d

# Google OAuth Credentials (for Sign in with Google)
# Obtain from Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
VITE_GOOGLE_CLIENT_ID=

# Neon PostgreSQL Database Connection String
# In Vercel: Connect via Vercel Integrations -> Neon, or set DATABASE_URL in Vercel Project Settings.
# Example: postgresql://user:password@ep-xyz.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=
POSTGRES_URL=

# Admin Account Credentials
ADMIN_EMAIL=vedikgannoji5126@gmail.com
ADMIN_PASSWORD=your-secure-admin-password

# API Base URL (Frontend)
# Same-origin by default. Leave empty in production on Vercel (defaults to /api).
VITE_API_URL=

# Cashfree Payment Gateway Credentials
# Sandbox for development and testing; set to "production" when launching live payments
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
CASHFREE_ENVIRONMENT=sandbox
