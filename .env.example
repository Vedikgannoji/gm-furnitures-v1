# Server Configuration
PORT=3001
NODE_ENV=development
APP_URL=http://localhost:5173

# Authentication Secrets
JWT_SECRET=your_jwt_secret_change_in_production
JWT_EXPIRES_IN=7d

# Google OAuth Credentials (for Sign in with Google)
# Obtain from Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
VITE_GOOGLE_CLIENT_ID=

# Database Configuration (Path to SQLite file)
DATABASE_PATH=server/data/gm_furniture.db

# Admin Account
ADMIN_EMAIL=your-admin@email.com
ADMIN_PASSWORD=your-admin-password

# ============================================================
# PRODUCTION (Vercel frontend + Railway/Render backend)
# ============================================================
# Set this in your Vercel project environment variables:
#
#   VITE_API_URL = https://your-railway-app.railway.app
#
# This tells the React frontend where the Express API server lives.
# Leave empty for local development (Vite proxy handles /api → localhost:3001).
VITE_API_URL=
